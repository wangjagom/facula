---
/**
 * 교재 한 권 = 한 페이지(A1). build.py의 page 템플릿과 같은 마크업이에요.
 * 부·개념 페이지 이동은 app.js가 해시(#part-N, #sN)로 해요.
 */
import '../styles/fonts.css';
import '../styles/style.css';
import appJs from '../scripts/app.js?raw';
import type { BookModel } from '../lib/book/types';
import { renderBody, renderToc, renderRail, renderOtp } from '../lib/book/render';
import { iconDefs } from '../lib/book/icons';
import { figureIconDefs, refpeekAssets } from '../lib/book/legacy';

interface Props { book: BookModel }
const { book } = Astro.props;
const cfg = book.config;
const body = renderBody(book);
const toc = renderToc(book);
const rail = renderRail(book);
const otp = renderOtp(book);
const defs = iconDefs(body, toc, rail) + figureIconDefs();
const meta = cfg.meta.map((m) => `<span>${m}</span>`).join('');
const peek = cfg.refpeek ? refpeekAssets(cfg.refpeek) : '';
const CLOSE = "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' aria-hidden='true'><path d='M6 6l12 12M18 6L6 18'/></svg>";
const MENU = "<svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' aria-hidden='true'><path d='M4 7h16M4 12h16M4 17h16'/></svg>";
const PANEL = "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><rect x='3' y='4' width='18' height='16' rx='2'/><path d='M9 4v16'/></svg>";
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{cfg.title}</title>
<script is:inline>document.documentElement.className += " paged"; try { if (localStorage.getItem("sideCollapsed") === "1") document.documentElement.className += " side-collapsed"; } catch (e) {}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
<script is:inline>try{if(localStorage.getItem("abapSyn")!=="new")document.documentElement.dataset.syn="old"}catch(e){document.documentElement.dataset.syn="old"}</script>
<header class="m-bar"><button class="m-menu" type="button" aria-label="목차 열기" aria-controls="m-drawer" aria-expanded="false"><Fragment set:html={MENU} /><span>목차</span></button><span class="m-cur" aria-live="polite"></span></header>
<div class="m-scrim"></div>
<aside class="m-drawer" id="m-drawer" aria-label="목차" aria-hidden="true"><div class="m-drawer-head"><b>목차</b><button class="m-close" type="button" aria-label="목차 닫기"><Fragment set:html={CLOSE} /></button></div><nav set:html={toc} /></aside>
<Fragment set:html={defs} />
<a class="skip" href="#main">본문으로 건너뛰기</a>
<div class="shell">
  <aside class="sidebar" id="sidebar" aria-label="목차">
    <div class="side-stack">
      <div class="side-inner">
        <div class="brand-row">
          <a class="brand" href="#part-0">{cfg.title}</a>
          <button class="side-toggle" type="button" aria-label="목차 접기" title="목차 접기" aria-controls="sidebar" aria-expanded="true"><Fragment set:html={PANEL} /></button>
        </div>
        <nav set:html={toc} />
      </div>
      <nav class="rail" aria-label="부 바로가기">
        <button class="side-toggle" type="button" aria-label="목차 펼치기" title="목차 펼치기" aria-controls="sidebar" aria-expanded="false"><Fragment set:html={PANEL} /></button>
        <div class="rail-list" set:html={rail} />
      </nav>
    </div>
  </aside>
  <main id="main" class="content">
    <div class="content-grid">
      <div class="col">
        <header class="masthead">
          <p class="kicker">{cfg.kicker}</p>
          <h1>{cfg.title}</h1>
          <p class="sub">{cfg.sub}</p>
          <p class="meta" set:html={meta} />
        </header>
        <article class="prose" set:html={body} />
        <footer class="foot"><a href="#main">맨 위로 ↑</a></footer>
      </div>
      <aside class="otp" aria-label="이 부분의 소제목">
        <div class="otp-inner">
          <p class="otp-title">이 부의 개념</p>
          <Fragment set:html={otp} />
        </div>
      </aside>
    </div>
  </main>
</div>
<script is:inline set:html={appJs} />
<Fragment set:html={peek} />
</body>
</html>
